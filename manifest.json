{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "./index.html",
  "name": "My Vault",
  "short_name": "MyVault",
  "description": "My Vault v1.0 — Offline Lifetime Family Chronicle, Document Vault, Health Hub & House Logs Safe Deposit Locker",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#dc2626",
  "dir": "ltr",
  "lang": "en-US",
  "categories": [
    "lifestyle",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Log Life Event",
      "short_name": "Event",
      "description": "Quickly chronicle a new family milestone or diary note",
      "url": "./index.html#shortcut=add-event",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Document Vault",
      "short_name": "Vault",
      "description": "View encrypted certificates, deeds, and official IDs",
      "url": "./index.html#shortcut=vault",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Medical Hub",
      "short_name": "Medical",
      "description": "Review doctor checkups and upcoming family health appointments",
      "url": "./index.html#shortcut=medical",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Growth Timelapse",
      "short_name": "Growth",
      "description": "View children's annual milestone photos and growth slider",
      "url": "./index.html#shortcut=growth",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Executive Dashboard & Timeline View"
    },
    {
      "src": "screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Heritage Vault Desktop Chronicle"
    }
  ]
}
